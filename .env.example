# Docker Compose project
COMPOSE_PROJECT_NAME=lms-dev

# Runtime images
FRAPPE_BENCH_IMAGE=frappe/bench:latest
REDIS_IMAGE=redis:alpine
POSTGRES_VERSION=15.17

# Frappe applications
FRAPPE_BRANCH=develop
PAYMENTS_REPO=https://github.com/frappe/payments
PAYMENTS_BRANCH=develop

# Local Frappe site
SITE_NAME=lms.localhost
SITE_ADMIN_PASSWORD=admin

# Where the app is mounted. Empty means the site root, so the app is at
# http://localhost:8000/ and its pages are /courses, /batches and so on.
# Set to `lms` to serve it under a /lms prefix instead.
LMS_PATH=

# PostgreSQL development credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123

# Host ports
BACKEND_PORT=8000
VITE_PORT=8080
SOCKETIO_PORT=9000

# Transactional email (SendGrid). When SENDGRID_API_KEY is unset, mail goes to
# the local mailpit container instead of being delivered, and every message --
# sign-up verification, "Login with Email Link", notifications -- is readable
# with its links live at http://localhost:8025. Nothing leaves your machine.
#
# Set the key to send for real. FROM_EMAIL must be a verified sender or on an
# authenticated domain, or SendGrid rejects the message with a 403. The key is
# written into the site's site_config.json in plain text; that lives in the
# `bench` docker volume, not your checkout, and `down -v` removes it.
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@lms.localhost
MAIL_SENDER_NAME=Jutsu Academy

# Local mail catcher, used whenever SENDGRID_API_KEY is empty.
MAILPIT_IMAGE=axllent/mailpit:latest
MAILPIT_UI_PORT=8025
MAIL_SERVER=mailpit
MAIL_PORT=1025

# Any other SMTP relay: leave SENDGRID_API_KEY empty and point MAIL_SERVER and
# MAIL_PORT at it. An Email Account created in the desk beats all of these.

# Frontend build memory limit in MB
NODE_MEMORY_MB=6144
