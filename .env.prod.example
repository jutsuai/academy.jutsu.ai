# Production environment for docker/docker-compose.prod.yml.
#
# In Dokploy, paste these into the application's Environment tab rather than
# committing a filled-in copy. Locally, `cp .env.prod.example .env.prod` and run
# with `--env-file .env.prod`.
#
# The four marked REQUIRED have no defaults on purpose -- compose refuses to
# start without them rather than quietly bringing up a site with a guessable
# password.

COMPOSE_PROJECT_NAME=lms

# --- REQUIRED -----------------------------------------------------------------
# The Frappe site name. This is an internal identity, not necessarily your
# public domain: nginx sends it as X-Frappe-Site-Name on every proxied request,
# so the site keeps working whatever hostname the PaaS router puts in Host.
# Changing it later means creating a new site, so pick one and keep it.
SITE_NAME=lms.jutsu.ai

# Postgres superuser password. Also what `bench new-site` uses to create the
# site's own database and role on the first deploy.
POSTGRES_PASSWORD=

# The site's Administrator password, set once when the site is created. Changing
# this value afterwards does nothing; use `bench --site <site> set-admin-password`.
ADMIN_PASSWORD=
# ------------------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_VERSION=15.17
REDIS_IMAGE=redis:alpine
NGINX_IMAGE=nginx:alpine

# Where the app is mounted. Empty means the site root, so the LMS is at / and
# its pages are /courses, /batches. Set to `lms` to serve it under a /lms prefix.
LMS_PATH=

# The port nginx publishes on the host. Attach your PaaS domain to this.
HTTP_PORT=8080

# Gunicorn. (2 x cores) + 1 workers is the usual starting point; threads matter
# more than workers here because Frappe requests spend most of their time
# waiting on Postgres.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# All three queues in one worker. Split into two services if a long job starts
# delaying notifications -- see the comment in docker-compose.prod.yml.
WORKER_QUEUES=short,default,long

CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120

# Transactional email (SendGrid). Leave the key empty and set MAIL_SERVER below
# for any other relay. With NEITHER set, sign-up verification and "Login with
# Email Link" report success and send nothing -- Frappe takes a silent fallback
# branch -- so configure one before letting real users near the site.
#
# FROM_EMAIL must be a verified sender or on an authenticated domain in your
# SendGrid account, or every send is rejected with a 403.
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@jutsu.ai
MAIL_SENDER_NAME=Jutsu Academy

# Any other SMTP relay, used only when SENDGRID_API_KEY is empty.
MAIL_SERVER=
MAIL_PORT=587
MAIL_LOGIN=
MAIL_PASSWORD=

# Build-time. Node needs a large heap for the SPA bundle; if your build host has
# less than ~8 GB, the image build fails rather than degrades.
NODE_MEMORY_MB=6144
FRAPPE_BRANCH=develop
PAYMENTS_BRANCH=develop
